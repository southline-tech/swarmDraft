{
  "name": "swarmdraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @swarmdraft/desktop tauri dev",
    "dev:web": "pnpm --filter @swarmdraft/desktop dev",
    "build": "pnpm -r build",
    "tauri": "pnpm --filter @swarmdraft/desktop tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vue-eslint-parser": "^9.4.3"
  }
}
