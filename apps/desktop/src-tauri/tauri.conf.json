{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swarmDraft",
  "mainBinaryName": "swarmdraft",
  "version": "0.1.1",
  "identifier": "com.radiancelux.swarmdraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "swarmDraft",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["draft"],
        "description": "swarmDraft manuscript",
        "mimeType": "application/x-swarmdraft-draft"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-pages.nsh",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "template": "windows/installer.nsi",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "publisher": "Radiance Lux Technologies LLC",
    "copyright": "© 2026 Radiance Lux Technologies LLC"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MkRCQjNCRkU0QjI1QzIKUldUQ0pVditPN3N0WiswM2N6SE1ZeTB1ZWwrOEc3WDhhRGF1WHcvUi83QnVuTko1U1VsYm43NlkK",
      "endpoints": [
        "https://github.com/southline-tech/swarmDraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
